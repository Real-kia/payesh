[Unit]
Description=Payesh Bandwidth Controls module for %i
After=network-online.target payesh-server.service payesh-bandwidth-watchdog@%i.service
Wants=network-online.target
Requires=payesh-bandwidth-watchdog@%i.service

[Service]
Type=simple
EnvironmentFile=-/etc/payesh/bandwidth.env
ExecStart=/var/lib/payesh/modules/%i/bandwidth-controls/active/bin/bandwidth-controls --db /var/lib/payesh/payesh.db --server-id %i --state-dir /var/lib/payesh/bandwidth --socket /run/payesh/bandwidth.sock --management-confirm-url ${PAYESH_MANAGEMENT_CONFIRM_URL}
User=root
Group=payesh
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/payesh /run/payesh
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
