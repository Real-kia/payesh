[Unit]
Description=Payesh local monitoring agent
After=network-online.target payesh-server.service
Wants=network-online.target

[Service]
Type=simple
User=payesh
Group=payesh
EnvironmentFile=-/etc/payesh/payesh.env
ExecStartPre=/bin/sh -c 'if [ -z "$PAYESH_TRANSPORT_URL" ]; then /usr/bin/payesh register-server -ensure -db=/var/lib/payesh/payesh.db -identity-file=/var/lib/payesh/server-id >/dev/null; fi'
ExecStart=/bin/bash -o pipefail -c 'if [ -n "$PAYESH_TRANSPORT_URL" ]; then exec /usr/bin/payesh-agent -interval=15s; else exec /usr/bin/payesh-agent -interval=15s -identity-file=/var/lib/payesh/server-id | /usr/bin/payesh ingest -db=/var/lib/payesh/payesh.db -identity-file=/var/lib/payesh/server-id -follow >/dev/null; fi'
Restart=on-failure
RestartSec=5s
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/payesh /var/log/payesh
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
# The local ingest process consumes the node-sample stream. Bash pipefail keeps
# either child failure visible to systemd. Keep routine acknowledgements out of
# journald; diagnostics remain available on stderr.
StandardOutput=null
StandardError=append:/var/log/payesh/agent.err

[Install]
WantedBy=multi-user.target
