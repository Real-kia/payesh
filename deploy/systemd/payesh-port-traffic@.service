[Unit]
Description=Payesh Port Traffic module for %i
After=network-online.target payesh-server.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/var/lib/payesh/modules/%i/port-traffic/active/bin/port-traffic --db /var/lib/payesh/payesh.db --server-id %i
User=root
Group=payesh
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/payesh
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
