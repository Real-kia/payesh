#!/sbin/openrc-run
name="payesh-server"
description="Payesh local monitoring server"
command="/bin/sh"
command_args="-c 'if [ -f /etc/payesh/payesh.env ]; then set -a; . /etc/payesh/payesh.env; set +a; fi; exec /usr/bin/payesh-server -db=/var/lib/payesh/payesh.db -listen=0.0.0.0:8787'"
command_user="payesh:payesh"
capabilities="^cap_net_bind_service"
supervisor="supervise-daemon"
supervise_daemon_args="--respawn-delay 5"
output_log="/var/log/payesh/server.log"
error_log="/var/log/payesh/server.err"

depend() {
	need net
	after firewall
}
